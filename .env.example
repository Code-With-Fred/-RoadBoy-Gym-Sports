# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://roadboygym.ng

# ---------------------------------------------------------------------------
# Supabase (public — safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
# They are read exclusively from server components / route handlers.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Paystack public key is safe in the browser (used only to open the checkout).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
